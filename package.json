{
  "name": "markshelf",
  "version": "0.6.0",
  "description": "Structured markdown viewer for git repositories",
  "license": "MIT",
  "author": "sksp.work",
  "homepage": "https://github.com/skspwork/markshelf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skspwork/markshelf.git"
  },
  "bugs": {
    "url": "https://github.com/skspwork/markshelf/issues"
  },
  "keywords": [
    "markdown",
    "viewer",
    "docs",
    "documentation",
    "git",
    "nextjs",
    "graph",
    "knowledge-base",
    "oss"
  ],
  "bin": {
    "markshelf": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    ".next/standalone",
    ".next/static",
    "public"
  ],
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/pack-static.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t markshelf-base .",
    "docker:run": "node scripts/docker-run.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "cytoscape": "^3.35.0",
    "cytoscape-fcose": "^2.2.0",
    "lucide-react": "^1.75.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
